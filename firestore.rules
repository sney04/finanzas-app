rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre', 'apellido', 'moneda', 'metaAhorroMensual', 'updatedAt'
        ])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;

      match /transactions/{transactionId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidTransaction(request.resource.data, userId)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /categories/{categoryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCategory(request.resource.data);
      }

      match /accounts/{accountId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAccount(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidAccount(request.resource.data, userId)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /debts/{debtId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDebt(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidDebt(request.resource.data, userId)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /debtPayments/{debtPaymentId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDebtPayment(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidDebtPayment(request.resource.data, userId)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /budgets/{budgetId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBudget(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidBudget(request.resource.data, userId)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /savingsGoals/{savingsGoalId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSavingsGoal(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidSavingsGoal(request.resource.data, userId)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasOnly([
          'nombre', 'apellido', 'email', 'telefono', 'fotoUrl',
          'moneda', 'metaAhorroMensual', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'nombre', 'email', 'moneda', 'metaAhorroMensual', 'createdAt'
        ])
        && data.nombre is string
        && data.nombre.size() > 0
        && data.nombre.size() <= 100
        && (!('apellido' in data)
            || data.apellido == null
            || (data.apellido is string && data.apellido.size() <= 100))
        && (data.email == null
            || (data.email is string && data.email.size() > 0 && data.email.size() <= 254))
        && (!('telefono' in data)
            || data.telefono == null
            || (data.telefono is string && data.telefono.size() <= 32))
        && (!('fotoUrl' in data)
            || data.fotoUrl == null
            || (data.fotoUrl is string
                && data.fotoUrl.size() <= 2048
                && data.fotoUrl.matches('^https://.*$')))
        && (data.moneda == 'COP' || data.moneda == 'USD' || data.moneda == 'EUR')
        && data.metaAhorroMensual is number
        && data.metaAhorroMensual >= 0
        && data.metaAhorroMensual <= 1000000000
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll([
          'type', 'amount', 'category', 'description', 'date', 'createdAt', 'userId'
        ])
        && data.keys().hasOnly([
          'type', 'amount', 'category', 'description', 'date', 'createdAt', 'accountId', 'userId', 'destinationAccountId'
        ])
        && data.type is string
        && (data.type == 'income' || data.type == 'expense' || data.type == 'transfer')
        && data.amount is number
        && data.amount > 0
        && data.userId is string
        && data.userId == userId
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 100
        && data.description is string
        && data.description.size() <= 300
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.type != 'transfer'
            || (data.accountId is string
                && data.accountId.size() > 0
                && data.destinationAccountId is string
                && data.destinationAccountId.size() > 0
                && data.destinationAccountId != data.accountId))
        && (data.type == 'transfer'
            || !('destinationAccountId' in data))
        && data.createdAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasOnly(['name'])
        && data.keys().hasAll(['name'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 50;
    }

    function isValidAccount(data, userId) {
      return data.keys().hasAll(['nombre', 'tipo', 'saldo', 'moneda', 'userId', 'createdAt'])
        && data.userId is string && data.userId == userId
        && data.keys().hasOnly(['nombre', 'tipo', 'saldo', 'moneda', 'descripcion', 'userId', 'createdAt', 'updatedAt'])
        && data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 100
        && data.tipo is string && (data.tipo == 'efectivo' || data.tipo == 'bancaria' || data.tipo == 'nequi' || data.tipo == 'daviplata' || data.tipo == 'otro')
        && data.saldo is number && data.saldo >= 0
        && data.moneda is string && data.moneda.size() > 0 && data.moneda.size() <= 10
        && (!('descripcion' in data) || (data.descripcion is string && data.descripcion.size() <= 300))
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidDebt(data, userId) {
      return data.keys().hasAll(['nombre', 'acreedor', 'montoOriginal', 'saldoPendiente', 'fechaVencimiento', 'estado', 'userId', 'createdAt'])
        && data.userId is string && data.userId == userId
        && data.keys().hasOnly(['nombre', 'acreedor', 'montoOriginal', 'saldoPendiente', 'fechaVencimiento', 'estado', 'descripcion', 'userId', 'createdAt', 'updatedAt'])
        && data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 100
        && data.acreedor is string && data.acreedor.size() > 0 && data.acreedor.size() <= 100
        && data.montoOriginal is number && data.montoOriginal > 0
        && data.saldoPendiente is number && data.saldoPendiente >= 0
        && data.saldoPendiente <= data.montoOriginal
        && data.fechaVencimiento is string && data.fechaVencimiento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.estado is string && (data.estado == 'active' || data.estado == 'paid' || data.estado == 'cancelled')
        && (!('descripcion' in data) || (data.descripcion is string && data.descripcion.size() <= 300))
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidDebtPayment(data, userId) {
      return data.keys().hasAll(['debtId', 'monto', 'fecha', 'userId', 'createdAt'])
        && data.userId is string && data.userId == userId
        && data.keys().hasOnly(['debtId', 'monto', 'fecha', 'descripcion', 'userId', 'createdAt'])
        && data.debtId is string && data.debtId.size() > 0 && data.debtId.size() <= 100
        && data.monto is number && data.monto > 0
        && data.fecha is string && data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('descripcion' in data) || (data.descripcion is string && data.descripcion.size() <= 300))
        && data.createdAt is timestamp;
    }

    function isValidBudget(data, userId) {
      return data.keys().hasAll(['categoria', 'montoPresupuesto', 'periodo', 'userId', 'createdAt'])
        && data.userId is string && data.userId == userId
        && data.keys().hasOnly(['categoria', 'montoPresupuesto', 'periodo', 'userId', 'createdAt', 'updatedAt'])
        && data.categoria is string && data.categoria.size() > 0 && data.categoria.size() <= 100
        && data.montoPresupuesto is number && data.montoPresupuesto > 0
        && data.periodo is string && (data.periodo == 'monthly' || data.periodo == 'yearly')
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidSavingsGoal(data, userId) {
      return data.keys().hasAll(['nombre', 'objetivo', 'montoActual', 'fechaObjetivo', 'estado', 'userId', 'createdAt'])
        && data.userId is string && data.userId == userId
        && data.keys().hasOnly(['nombre', 'objetivo', 'montoActual', 'fechaObjetivo', 'estado', 'descripcion', 'userId', 'createdAt', 'updatedAt'])
        && data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 100
        && data.objetivo is number && data.objetivo > 0
        && data.montoActual is number && data.montoActual >= 0
        && data.fechaObjetivo is string && data.fechaObjetivo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.estado is string && (data.estado == 'active' || data.estado == 'completed' || data.estado == 'cancelled')
        && (!('descripcion' in data) || (data.descripcion is string && data.descripcion.size() <= 300))
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
  }
}
